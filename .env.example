# Jev Playground environment. Copy to .env.local and fill in what you need:
#   cp .env.example .env.local
#
# Everything is optional. With no endpoint, the app runs fully offline using the
# built-in keyword classifier ("jev-offline").

# The Cloudflare Worker (see worker/) that holds the OpenRouter key and calls Jev.
NEXT_PUBLIC_JEV_ENDPOINT=https://jev-playground.himanshubhusari.workers.dev

# Force the offline classifier even when an endpoint is set (handy for UI work and demos).
NEXT_PUBLIC_USE_MOCK=false

# Public URL, used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://himanshubhusari.com/jevplayground/
